#!/usr/bin/env python3
"""Collect SMART health for every disk and write one summary JSON file.

Runs as root from disk-health.service (hourly via disk-health.timer). The
desktop side -- the alert service and the details panel -- only ever reads the
file this writes, so nothing in the user session needs privileges.

Each drive gets a status of ok, warning, critical, or unavailable plus a list
of human-readable problems. The overall status is the worst of the drives.
Drives that can't report SMART (e.g. a USB enclosure that hides it), or whose
data can't be understood, are "unavailable": shown, never alerted on, and
never allowed to stop the other drives from being checked.

Attribute numbers mean different things on different drives (202 is a
lifespan figure on some SSDs and an error counter on some HDDs), so wear is
read by the attribute *name* smartctl assigns from its drive database, never
by number alone. A drive whose wear can't be identified shows no lifespan.

  disk-health-collect            write the status file (what the timer runs)
  disk-health-collect --report   print raw smartctl data + conclusions for
                                 every drive, serial numbers removed, for
                                 attaching to a bug report

Env overrides (for testing): DISK_HEALTH_OUT, SMARTCTL, DISK_HEALTH_DRIVEDB.
"""

import json
import os
import subprocess
import sys
import tempfile
import time

OUT = os.environ.get("DISK_HEALTH_OUT", "/var/lib/disk-health/status.json")
SMARTCTL = os.environ.get("SMARTCTL", "smartctl")
# Kept current weekly by disk-health-drivedb.timer; smartctl's built-in
# database is used until the first update lands (or if updates fail).
DRIVEDB = os.environ.get("DISK_HEALTH_DRIVEDB", "/var/lib/disk-health/drivedb.h")
VERSION = "0.9.0"

LEVELS = {"ok": 0, "unavailable": 0, "warning": 1, "critical": 2}

# Fallback temperature limits (°C) when the drive doesn't report its own.
DEFAULT_TEMP = {"NVMe": (70, 80), "ATA": (55, 60)}

# smartctl exit status bits (see smartctl(8) "RETURN VALUES").
BIT_OPEN_FAILED = 1 << 1
BIT_SMART_FAILED = 1 << 2
BIT_DISK_FAILING = 1 << 3
BIT_PREFAIL_NOW = 1 << 4
BIT_PAST_THRESHOLD = 1 << 5

NVME_CRITICAL_WARNING_BITS = [
    (0x01, "available spare below threshold"),
    (0x02, "temperature outside safe range"),
    (0x04, "reliability degraded by media or internal errors"),
    (0x08, "media placed in read-only mode"),
    (0x10, "volatile memory backup failed"),
    (0x20, "persistent memory region unreliable"),
]


# Wear attributes by name (from smartctl's drive database). "Remaining" ones
# have a normalized value counting down from 100; "used" ones carry the
# percentage used in the raw value.
WEAR_REMAINING = {
    "wear_leveling_count", "percent_lifetime_remain", "ssd_life_left",
    "lifetime_left", "media_wearout_indicator", "remaining_lifetime_perc",
}
WEAR_USED_RAW = {"perc_rated_life_used", "percent_lifetime_used"}


def as_int(value):
    """An int, or None for anything that isn't a plain number."""
    if isinstance(value, bool):
        return None
    if isinstance(value, int):
        return value
    if isinstance(value, float) and value.is_integer():
        return int(value)
    return None


def run_smartctl(args):
    drivedb = ["-B", DRIVEDB] if os.path.isfile(DRIVEDB) else []
    proc = subprocess.run([SMARTCTL, "--json=c", *drivedb, *args], capture_output=True, text=True)
    try:
        data = json.loads(proc.stdout) if proc.stdout.strip() else {}
    except json.JSONDecodeError:
        data = {}
    return proc.returncode, data


def smartctl_messages(data):
    msgs = (data.get("smartctl") or {}).get("messages") or []
    return [m.get("string", "") for m in msgs if m.get("string")]


def ata_rows(data):
    table = (data.get("ata_smart_attributes") or {}).get("table")
    return [row for row in table if isinstance(row, dict)] if isinstance(table, list) else []


def ata_raw(data, attr_id):
    for row in ata_rows(data):
        if row.get("id") == attr_id:
            return as_int((row.get("raw") or {}).get("value"))
    return None


def life_used_pct(data, nvme):
    # Standard, vendor-neutral figures first: NVMe "Percentage Used", then the
    # ATA Device Statistics endurance indicator.
    for value in (nvme.get("percentage_used"), (data.get("endurance_used") or {}).get("current_percent")):
        if as_int(value) is not None:
            return as_int(value)
    for row in ata_rows(data):
        name = str(row.get("name") or "").lower()
        if name in WEAR_REMAINING:
            value = as_int(row.get("value"))
            if value is not None and 0 < value <= 100:
                return 100 - value
        elif name in WEAR_USED_RAW:
            value = as_int((row.get("raw") or {}).get("value"))
            if value is not None and 0 <= value <= 200:
                return value
    return None


def summarize(dev, rc, data, previous):
    protocol = (data.get("device") or {}).get("protocol") or dev.get("protocol") or ""
    nvme = data.get("nvme_smart_health_information_log") or {}
    temp = data.get("temperature") or {}
    drive = {
        "device": dev["name"],
        "type": dev.get("type", ""),
        "protocol": protocol,
        "model": data.get("model_name") or data.get("scsi_model_name") or dev["name"],
        "serial": data.get("serial_number") or "",
        "firmware": data.get("firmware_version") or "",
        "capacity_bytes": (data.get("user_capacity") or {}).get("bytes"),
        "smart_passed": (data.get("smart_status") or {}).get("passed"),
        "temperature_c": as_int(temp.get("current", nvme.get("temperature"))),
        "life_used_pct": life_used_pct(data, nvme),
        "spare_pct": as_int(nvme.get("available_spare")),
        "spare_threshold_pct": as_int(nvme.get("available_spare_threshold")),
        "power_on_hours": as_int((data.get("power_on_time") or {}).get("hours", nvme.get("power_on_hours"))),
        "power_cycles": as_int(data.get("power_cycle_count", nvme.get("power_cycles"))),
        "unsafe_shutdowns": as_int(nvme.get("unsafe_shutdowns")),
        "media_errors": as_int(nvme.get("media_errors")),
        "error_log_entries": as_int(nvme.get("num_err_log_entries")),
        "reallocated_sectors": ata_raw(data, 5),
        "pending_sectors": ata_raw(data, 197),
        "offline_uncorrectable": ata_raw(data, 198),
        "data_written_bytes": as_int(nvme.get("data_units_written")) * 512000 if as_int(nvme.get("data_units_written")) is not None else None,
        "status": "ok",
        "problems": [],
        "note": "",
    }

    defaults = DEFAULT_TEMP["NVMe" if protocol == "NVMe" else "ATA"]
    drive["temperature_warn_c"] = as_int(temp.get("op_limit_max")) or defaults[0]
    drive["temperature_crit_c"] = as_int(temp.get("critical_limit_max")) or defaults[1]

    no_smart = not data.get("smart_status") and not nvme and not ata_rows(data)
    if rc & BIT_OPEN_FAILED or no_smart:
        messages = smartctl_messages(data)
        if any("STANDBY" in m.upper() for m in messages) and previous:
            # Asleep: don't spin it up -- keep the last real reading.
            kept = dict(previous)
            kept["note"] = "Drive was asleep at the last check; showing the previous reading."
            return kept
        drive["status"] = "unavailable"
        drive["note"] = messages[0] if messages else "SMART data is not available for this drive."
        return drive

    problems = drive["problems"]

    def flag(level, text):
        problems.append({"level": level, "text": text})

    if drive["smart_passed"] is False or rc & BIT_DISK_FAILING:
        flag("critical", "SMART overall health check FAILED")

    cw = as_int(nvme.get("critical_warning")) or 0
    for bit, text in NVME_CRITICAL_WARNING_BITS:
        if cw & bit:
            flag("critical", "NVMe critical warning: " + text)

    if drive["media_errors"]:
        flag("critical", f"{drive['media_errors']} media/data integrity errors")

    spare, spare_thr = drive["spare_pct"], drive["spare_threshold_pct"]
    if spare is not None and spare_thr is not None and not cw & 0x01:
        if spare <= spare_thr + 10:
            flag("warning", f"Spare capacity low ({spare}%, threshold {spare_thr}%)")

    if drive["pending_sectors"]:
        flag("critical", f"{drive['pending_sectors']} sectors pending reallocation")
    if drive["offline_uncorrectable"]:
        flag("critical", f"{drive['offline_uncorrectable']} uncorrectable sectors")
    if drive["reallocated_sectors"]:
        grew = ""
        before = (previous or {}).get("reallocated_sectors")
        if isinstance(before, int) and drive["reallocated_sectors"] > before:
            grew = f" (+{drive['reallocated_sectors'] - before} since last check)"
        flag("warning", f"{drive['reallocated_sectors']} reallocated sectors{grew}")

    for row in ata_rows(data):
        when = row.get("when_failed") or ""
        if when == "now":
            flag("critical", f"Attribute {row.get('name')} is below its failure threshold")
        elif when == "past":
            flag("warning", f"Attribute {row.get('name')} was below its failure threshold in the past")

    life = drive["life_used_pct"]
    if life is not None:
        if life >= 90:
            flag("critical", f"{life}% of rated lifespan used")
        elif life >= 80:
            flag("warning", f"{life}% of rated lifespan used")

    t = drive["temperature_c"]
    if isinstance(t, (int, float)):
        if t >= drive["temperature_crit_c"]:
            flag("critical", f"Temperature critical ({t}°C)")
        elif t >= drive["temperature_warn_c"]:
            flag("warning", f"Temperature high ({t}°C)")

    worst = max((LEVELS[p["level"]] for p in problems), default=0)
    drive["status"] = {0: "ok", 1: "warning", 2: "critical"}[worst]
    return drive


def load_previous():
    try:
        with open(OUT) as f:
            return {d.get("serial") or d.get("device"): d for d in json.load(f).get("drives", [])}
    except (OSError, ValueError):
        return {}


def read_drive(dev, previous):
    """Read and summarize one drive. Never raises: a drive whose data can't be
    understood is reported as unavailable so the other drives still get
    checked. Returns (summary, smartctl exit code, raw smartctl data)."""
    rc, data = 0, {}
    try:
        args = ["-a", "-n", "standby"]
        if dev.get("type"):
            args += ["-d", dev["type"]]
        rc, data = run_smartctl(args + [dev["name"]])
        if not isinstance(data, dict):
            raise TypeError("smartctl output is not a JSON object")
        key = data.get("serial_number") or dev["name"]
        prev = previous.get(key) or previous.get(dev["name"])
        return summarize(dev, rc, data, prev), rc, data
    except Exception as e:  # noqa: BLE001 -- isolate any one drive's failure
        print(f"disk-health: {dev.get('name')}: {type(e).__name__}: {e}", file=sys.stderr)
        return {
            "device": dev.get("name", "?"),
            "type": dev.get("type", ""),
            "protocol": dev.get("protocol", ""),
            "model": (data.get("model_name") if isinstance(data, dict) else None) or dev.get("name", "?"),
            "serial": (data.get("serial_number") if isinstance(data, dict) else None) or "",
            "status": "unavailable",
            "problems": [],
            "note": f"Couldn't read this drive's SMART data ({type(e).__name__}). "
                    "Please report it: sudo disk-health-collect --report",
        }, rc, data


def scan_devices():
    rc, scan = run_smartctl(["--scan-open"])
    devices = [d for d in (scan.get("devices") or []) if isinstance(d, dict) and d.get("name")]
    if not devices and rc != 0:
        print("smartctl --scan-open failed", file=sys.stderr)
    return devices, scan


REDACT_KEYS = {"serial_number", "serial", "wwn", "logical_unit_id", "eui64", "nguid"}


def redact(value):
    if isinstance(value, dict):
        return {k: ("REDACTED" if k in REDACT_KEYS else redact(v)) for k, v in value.items()}
    if isinstance(value, list):
        return [redact(v) for v in value]
    return value


def report():
    """Print everything needed to reproduce this machine's results in the
    test suite (tests/fixtures/), minus serial numbers and WWNs."""
    devices, scan = scan_devices()
    entries = []
    version = ""
    for dev in devices:
        summary, rc, data = read_drive(dev, {})
        if isinstance(data, dict) and not version:
            version = ".".join(str(v) for v in ((data.get("smartctl") or {}).get("version") or []))
        entries.append({"device": dev["name"], "smartctl_exit": rc,
                        "smartctl": redact(data), "summary": redact(summary)})
    json.dump({
        "disk_health_report": 1,
        "collector_version": VERSION,
        "smartctl_version": version,
        "drivedb": "updated" if os.path.isfile(DRIVEDB) else "built-in",
        "scan": redact(scan),
        "drives": entries,
    }, sys.stdout, indent=2)
    print()


def main():
    if sys.argv[1:] == ["--report"]:
        return report()
    if sys.argv[1:]:
        print("Usage: disk-health-collect [--report]", file=sys.stderr)
        return 2

    previous = load_previous()
    devices, _ = scan_devices()
    drives = [read_drive(dev, previous)[0] for dev in devices]

    now = time.time()
    status = max((d["status"] for d in drives), key=lambda s: LEVELS[s], default="ok")
    result = {
        "version": 1,
        "checked_at": time.strftime("%Y-%m-%dT%H:%M:%S%z", time.localtime(now)),
        "checked_at_epoch": int(now),
        "status": status,
        "drives": drives,
    }

    out_dir = os.path.dirname(OUT)
    os.makedirs(out_dir, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=out_dir, prefix=".status.")
    with os.fdopen(fd, "w") as f:
        json.dump(result, f, indent=2)
    os.chmod(tmp, 0o644)
    os.replace(tmp, OUT)
    print(f"disk-health: {status} ({len(drives)} drives)")


if __name__ == "__main__":
    sys.exit(main())
