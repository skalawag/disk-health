// Let administrators (wheel) at a local, active session refresh disk health
// (the panel's "Check Now" button) without a password. Only allows *starting*
// the one read-only collector unit.
polkit.addRule(function(action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" &&
      action.lookup("unit") == "disk-health.service" &&
      action.lookup("verb") == "start" &&
      subject.isInGroup("wheel") && subject.local && subject.active) {
    return polkit.Result.YES;
  }
});
